# ============================================================
# DSH Launcher · .gitignore
# 基于 flutter create 官方模板,补充 Windows 桌面项目常用项。
# ============================================================

# ---- Flutter / Dart ----
.dart_tool/
.packages
.pub-cache/
.pub/
/build/
/coverage/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
**/ios/Flutter/.last_build_id
app.*.symbols
app.*.map.json
.widget_preview/
migrate_working_dir/

# Android Studio 构建产物(本项目未用,保留以免误提交)
/android/app/debug
/android/app/profile
/android/app/release

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
*.suo
*.user
*.userosscache
*.sln.docstates
# .vscode 通常含共享的 launch/tasks 配置,默认不忽略;如需忽略取消下一行注释
#.vscode/

# ---- 构建/工具缓存 ----
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
*.class
*.pyc

# ---- 操作系统 ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- 日志与临时文件 ----
*.log
*.swp
*.tmp
*.bak
