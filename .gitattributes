# 统一换行符:避免 Windows 上反复出现 LF/CRLF 警告与无意义差异抖动。
* text=auto

# 源码与文档统一 LF
*.dart   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Windows 脚本保留 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制,不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.so   binary
